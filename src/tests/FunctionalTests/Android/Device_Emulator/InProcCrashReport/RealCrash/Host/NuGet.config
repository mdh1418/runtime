<?xml version="1.0" encoding="utf-8"?>
<!-- Isolated feed configuration for the host harness so it can restore the xUnit
     test packages from nuget.org independently of the runtime repo's locked-down
     NuGet.config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
