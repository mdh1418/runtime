<Project Sdk="Microsoft.NET.Sdk">
  <!-- ConsoleOnly: same synthetic crash data as RichSigsegv, but the reporter is
       given an empty report root so the JSON file sink is disabled (compact-log-only
       mode). Exercises the jsonEnabled==false / DiscardOutputCallback path and
       asserts no *.crashreport.json is produced while the console report still is. -->
  <PropertyGroup>
    <AssemblyName>Android.Device_Emulator.InProcCrashReport.ConsoleOnly.Test</AssemblyName>
    <MainLibraryFileName>Android.Device_Emulator.InProcCrashReport.ConsoleOnly.Test.dll</MainLibraryFileName>
    <DefineConstants>$(DefineConstants);INPROC_SCENARIO_CONSOLEONLY</DefineConstants>
  </PropertyGroup>

  <Import Project="../Shared/InProcCrashReport.Common.props" />
</Project>
